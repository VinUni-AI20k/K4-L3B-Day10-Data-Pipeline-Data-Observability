# Copy this file to .env at the repository root. Never put real keys here.
# Vietnamese step-by-step guide: docs/README_khoi.md
# Keep ONE active LLM_PROVIDER and ONE active LLM_MODEL in .env.
# Web demo: Gemini online or local extraction only. The other providers below
# configure the shared LLM router; they do NOT switch the web chat provider.

# GEMINI - recommended for demo/app.py (model used in the accepted demo).
# Create a key: https://aistudio.google.com/apikey
# Use GOOGLE_API_KEY for compatibility with both the web and core config.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
GOOGLE_API_KEY=
# GEMINI_API_KEY= is also accepted by the web/live-demo script, but not by
# core.config. Avoid setting both aliases to different keys.

# OPENAI - edit the two active provider/model lines above, do not duplicate them.
# Create a key: https://platform.openai.com/api-keys
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=

# OPENROUTER - use a chat model that supports tool calling, not an embedding model.
# Create a key: https://openrouter.ai/settings/keys
# LLM_PROVIDER=openrouter
# LLM_MODEL=openai/gpt-4.1-mini
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional providers already supported by the shared router.
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=

# Keep the accepted offline benchmark configuration and original raw snapshot.
RUN_RAGAS=0
REFRESH_SOURCE=0
REFRESH_TEST_SET=0
# Do not set HF_HUB_OFFLINE here before downloading MiniLM on a new machine.
